# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Browser (bundled into the site; Firebase web config is public by design) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Server only (read by /api functions; never prefix these with VITE_) ---
OPENAI_API_KEY=
# The whole service account JSON on one line, wrapped in single quotes.
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# Optional: requests per user per hour (defaults 40 and 30).
TAILOR_RATE_LIMIT_PER_HOUR=
MODELS_RATE_LIMIT_PER_HOUR=
