rules_version = '2';

// Security rules for every path the app uses. The server's admin SDK bypasses these rules.
// Deploy with: firebase deploy --only firestore:rules   (or paste into Firebase console > Firestore > Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permission', 'User') == 'Admin';
    }

    // Profiles. Users create and edit their own, but can't give themselves a role or AI access.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.get('permission', 'User') == 'User'
        && request.resource.data.get('aiAccess', false) == false;

      allow update: if isOwner(uid)
        && request.resource.data.get('permission', 'User') == resource.data.get('permission', 'User')
        && request.resource.data.get('aiAccess', false) == resource.data.get('aiAccess', false);

      // Admins manage everyone's role and AI access.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Each user's own data.
    match /jobApplications/{uid}/applications/{applicationId} {
      allow read, write: if isOwner(uid);
    }

    match /resumes/{uid}/data/{resumeId} {
      allow read, write: if isOwner(uid);
    }

    // Rules list, settings and saved sites.
    match /rules/{uid}/rules/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Per-user request counters, written only by the server.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // Anything not listed above is closed.
  }
}
